# Loreline configuration (copy to .env). All vars are prefixed LORELINE_.

# General
LORELINE_ENVIRONMENT=dev
LORELINE_DEBUG=false

# Storage
LORELINE_DATA_DIR=./data

# Web server (LAN-only by default)
LORELINE_HOST=127.0.0.1
LORELINE_PORT=8000

# Auth (single shared web-UI password). Empty = no auth (dev only).
LORELINE_AUTH_PASSWORD=
LORELINE_JWT_SECRET=change-me-in-prod
LORELINE_JWT_TTL_SECONDS=43200
# Reverse proxies (IPs/CIDRs, comma separated) allowed to speak for the client.
# Only from these does the app believe X-Forwarded-Proto when deciding whether
# the login cookie gets the Secure flag. Empty trusts nothing and reads the
# scheme off the connection itself; docker-compose.yml sets it for the bundled
# Caddy. Do not list a range your own clients connect from.
LORELINE_TRUSTED_PROXIES=

# Free-space floor in MB. Below it the health badge goes degraded and a running
# session pushes a low-disk alert. 0 disables both.
LORELINE_DISK_ALERT_THRESHOLD_MB=500

# Logging
LORELINE_LOG_LEVEL=INFO
LORELINE_LOG_JSON=false

# Provider API keys can be supplied here as overrides:
#   LORELINE_SECRET_<NAME>=...
# e.g.
# LORELINE_SECRET_DEEPGRAM=
# LORELINE_SECRET_OPENAI=
# LORELINE_SECRET_ASSEMBLYAI=
# LORELINE_SECRET_OPENROUTER=

# --- Optional: WUD (What's Up Docker) ---------------------------------------
# Read only when the optional wud profile is running
# (`docker compose --profile wud up -d`). Read the README's "Updating" section
# before enabling that profile - it hands a container the Docker socket, which
# is root on the host.
#
# These three are what make the web UI's "Update now" button work in a Docker
# deployment: the app asks WUD to re-check the registry and, if there is a
# newer image, to apply it. WUD holds the Docker socket; the app never does.
# deploy/install.sh generates all three for you.
#
# WUD authenticates with HTTP Basic, and it stores only a hash of the password,
# so the pair has to be written twice: the plaintext for the app to send, and
# an htpasswd hash for WUD to check it against. Generate a matching pair with
#   pw=$(openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 20)
#   echo "$pw"; openssl passwd -apr1 "$pw"
# Keep the hash in single quotes below. It contains `$` characters, and unquoted
# they read as variable references. Avoid `:` in the password: the library WUD
# authenticates with cannot handle one.
#
# With these unset the button reports what it always reported - update from the
# host - and WUD, if you started it anyway, allows anonymous access on the
# compose network. Nothing is published to the LAN either way.
# WUD_AUTH_USER=loreline
# WUD_AUTH_PASSWORD=
# WUD_AUTH_HASH='$apr1$xxxxxxxx$xxxxxxxxxxxxxxxxxxxxxx'

# Apply updates unattended at 04:00 instead of waiting for the Update button.
# Off by default: with the wud profile running and this unset, WUD notices a
# new image but leaves applying it to you.
# WUD_AUTO_UPDATE=true

# Timezone for WUD's 04:00 check. UTC if unset.
# TZ=Europe/Berlin
