# Loreline configuration (copy to .env). All vars are prefixed LORELINE_.

# General
LORELINE_ENVIRONMENT=dev
LORELINE_DEBUG=false

# Storage
LORELINE_DATA_DIR=./data

# Web server (LAN-only by default)
LORELINE_HOST=127.0.0.1
LORELINE_PORT=8000

# Auth (single shared web-UI password). Empty = no auth (dev only).
LORELINE_AUTH_PASSWORD=
LORELINE_JWT_SECRET=change-me-in-prod
LORELINE_JWT_TTL_SECONDS=43200
# Reverse proxies (IPs/CIDRs, comma separated) allowed to speak for the client.
# Only from these does the app believe X-Forwarded-Proto when deciding whether
# the login cookie gets the Secure flag. Empty trusts nothing and reads the
# scheme off the connection itself; docker-compose.yml sets it for the bundled
# Caddy. Do not list a range your own clients connect from.
LORELINE_TRUSTED_PROXIES=

# Free-space floor in MB. Below it the health badge goes degraded and a running
# session pushes a low-disk alert. 0 disables both.
LORELINE_DISK_ALERT_THRESHOLD_MB=500

# Logging
LORELINE_LOG_LEVEL=INFO
LORELINE_LOG_JSON=false

# Provider API keys can be supplied here as overrides:
#   LORELINE_SECRET_<NAME>=...
# e.g.
# LORELINE_SECRET_DEEPGRAM=
# LORELINE_SECRET_OPENAI=
# LORELINE_SECRET_ASSEMBLYAI=
# LORELINE_SECRET_OPENROUTER=

# --- Optional: Watchtower --------------------------------------------------
# Read only when the optional watchtower profile is running
# (`docker compose --profile watchtower up -d`). These are Watchtower's own
# variables, not Loreline's: no LORELINE_ prefix, and they are never passed to
# the app. Read the README's "Updating" section before enabling that profile -
# it hands a container the Docker socket, which is root on the host.
#
# Watchtower notifies through its own channels, not through Settings, Alerts in
# the web UI, which knows nothing about it. One shoutrrr URL, or several
# separated by spaces (https://containrrr.dev/shoutrrr/):
#   Discord          discord://token@channel
#   Slack            slack://watchtower@token-a/token-b/token-c
#   Generic webhook  generic+https://example.com/hook
# WATCHTOWER_NOTIFICATION_URL=

# Timezone for Watchtower's 04:00 update check. UTC if unset.
# TZ=Europe/Berlin

# Watchtower's HTTP API, which is what makes the web UI's "Update now" button
# work in a Docker deployment: the app POSTs a trigger for the same update the
# 04:00 check runs, to a container that already holds the Docker socket, and
# never gets that socket itself. deploy/install.sh writes both of these for you.
#
# Set both or neither. Watchtower exits at startup if the API is enabled with an
# empty token, and the app leaves the button's old "update from the host"
# message alone unless a token is set. docker-compose.yml passes this same value
# to the app as LORELINE_WATCHTOWER_TOKEN, so it is configured here once.
# Any long random string: `openssl rand -base64 24 | tr -dc 'A-Za-z0-9'`
# WATCHTOWER_HTTP_API_UPDATE=true
# WATCHTOWER_HTTP_API_TOKEN=
