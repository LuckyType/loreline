# Loreline configuration (copy to .env). All vars are prefixed LORELINE_.
#
# None of it is required to start. A bare
#   docker run -d --name loreline -p 8000:8000 -v loreline-data:/app/data \
#     ghcr.io/luckytype/loreline:latest
# comes up with no .env at all and asks for a password and a provider in the
# browser; this file is for the settings that have to be decided before the
# process starts, or that you would rather keep in a file than in a UI.

# General
LORELINE_ENVIRONMENT=dev
LORELINE_DEBUG=false

# Storage
LORELINE_DATA_DIR=./data

# Web server (LAN-only by default)
LORELINE_HOST=127.0.0.1
LORELINE_PORT=8000

# Auth (single shared web-UI password). Empty = the first run asks for one in
# the browser; set here it always wins over the one the first run stored, which
# is the way back into an instance whose password was mistyped.
LORELINE_AUTH_PASSWORD=
# Leave a passwordless instance open instead of gating it behind the first-run
# claim at /setup. Only for a dev box: false here means anyone who can reach
# the port can read every transcript and use every provider key.
LORELINE_FIRST_RUN_SETUP=true
LORELINE_JWT_SECRET=change-me-in-prod
LORELINE_JWT_TTL_SECONDS=43200
# Reverse proxies (IPs/CIDRs, comma separated) allowed to speak for the client.
# Only from these does the app believe X-Forwarded-Proto (whether the login
# cookie gets the Secure flag) and X-Forwarded-For (which client the login
# backoff counts against). Empty trusts nothing and reads both off the
# connection itself; docker-compose.yml sets it for the bundled Caddy. Do not
# list a range your own clients connect from.
#
# This also decides whether an HTTPS session reached through `tailscale serve`
# gets a Secure cookie, and it fails silently if it is wrong - see the README
# section "Recording from a laptop", which is also what makes recording from a
# browser possible at all. In the Docker stack the value below already covers
# it, because a host process reaching the published port arrives from the
# compose bridge gateway. On a source install, where tailscaled connects to the
# app over the loopback, set:
#   LORELINE_TRUSTED_PROXIES=127.0.0.1/32,::1/128
LORELINE_TRUSTED_PROXIES=

# Importing a recording made elsewhere (Sessions > Import recording). The size
# ceiling is checked on the upload and answered with 413; the length ceiling is
# checked after decoding and answered with 422. Four hours of 16 kHz mono is
# roughly 460 MB, so the defaults leave room for a long evening.
LORELINE_IMPORT_MAX_MB=1024
LORELINE_IMPORT_MAX_HOURS=8

# Free-space floor in MB. Below it the health badge goes degraded and a running
# session pushes a low-disk alert. 0 disables both.
LORELINE_DISK_ALERT_THRESHOLD_MB=500

# Logging
LORELINE_LOG_LEVEL=INFO
LORELINE_LOG_JSON=false

# --- Optional: settings the appliance stack sets for you -------------------
# docker-compose.yml gives the app container both of these, so on that
# deployment there is nothing to do here. They are listed because the values it
# uses name services that only exist in that file, and a deployment running the
# app on its own wants them empty, which is what they already are here.
#
# Base URL of a Docker API, which is what makes Settings > Services work.
# docker-compose.yml points it at its own docker-socket proxy. Blank, as here,
# turns that page off and says why. The app is never given the socket itself.
# LORELINE_DOCKER_API=

# Provider API keys can be supplied here as overrides:
#   LORELINE_SECRET_<NAME>=...
# e.g.
# LORELINE_SECRET_DEEPGRAM=
# LORELINE_SECRET_OPENAI=
# LORELINE_SECRET_ASSEMBLYAI=
# LORELINE_SECRET_OPENROUTER=

# --- Optional: compose profiles ---------------------------------------------
# Read by Docker Compose itself, not by the app, which is why it carries no
# LORELINE_ prefix. Compose takes its own pre-defined variables from the .env
# file in the working directory as well as from the shell, so a line here
# enables those profiles for every `docker compose` run in this directory,
# without the --profile flag. Comma separated for more than one.
#
# Worth setting for `diarization` in particular: that service is built from
# this checkout, and deploy/update.sh runs `up -d --build` with no profile of
# its own, so an install whose profile lives only in a shell command gets its
# app rebuilt on every update and its diarizer never. deploy/install.sh writes
# this line for you when diarization is chosen at install time.
#
# Note it also starts those services on a plain `docker compose up -d`, which
# is the point, but does mean a service stopped from Settings > Services comes
# back on the next update.
# COMPOSE_PROFILES=diarization

# --- Optional: the updater service ------------------------------------------
# Read by docker-compose.yml, not by the app's own settings, which is why these
# two carry no LORELINE_ prefix. Only meaningful when the optional updater
# profile is running (`docker compose --profile updater up -d`). Read the
# README's "Updating" section before enabling that profile - it hands a
# container the Docker socket, which is root on the host.
#
# The token is what makes the web UI's "Update now" button work in a Docker
# deployment: the app sends it to the updater service, which runs
# deploy/update-fast.sh on the app's behalf. The updater holds the Docker
# socket; the app never does. deploy/install.sh generates the token for you.
# Any opaque random string will do. To write one by hand:
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | cut -c1-20
# (install.sh's own gen_password trims with parameter expansion instead of that
# last pipe, because it runs under `set -o pipefail` where an early-exiting
# `head -c` would SIGPIPE the pipeline and fail the install. `cut` reads to EOF,
# so the line above is safe at a shell prompt.)
#
# Unset is a working state: the button reports what it always reported, that
# updates run from the host, and the updater service, if you started it anyway,
# refuses every request rather than accepting anonymous ones. Nothing is
# published to the LAN either way.
# UPDATER_TOKEN=

# Where this checkout lives on the host, as an absolute path. The updater
# container is given the repo at this same path inside itself, which has to
# match or the app container would be recreated against bind mounts that do not
# exist on the host. Leave it unset if you cloned to /opt/loreline, which is
# what the README and deploy/install.sh do.
# UPDATER_REPO_DIR=/opt/loreline
