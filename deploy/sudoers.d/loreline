# Allow the loreline service user to manage ONLY its own unit (for the web-UI
# autostart toggle and self-update restart). No other privileges granted.
#
# sudo matches the command path literally, and Python invokes these commands
# (resolved via $PATH, not a hardcoded path) - so both the /bin and /usr/bin
# locations are listed to cover distros (Debian/Raspberry Pi OS included)
# where they aren't the same inode.
#
# The self-update/rollback restart goes through `systemd-run`, not a plain
# `systemctl restart`: deploy/update.sh (and Updater.rollback) run *inside*
# the loreline unit they're restarting, so a plain restart's SIGTERM to the
# whole cgroup kills the script before it can report the new commit - even
# though the restart itself (and the update before it) succeeded. `--on-active`
# schedules the restart as a separate, detached transient unit a couple
# seconds out, giving the script time to finish and exit 0 first. The unit
# name is fixed (not autogenerated) so this exact command line stays
# sudoers-matchable; `--collect` cleans up that transient unit afterwards.
loreline ALL=(root) NOPASSWD: /bin/systemctl start loreline, /bin/systemctl stop loreline, /bin/systemctl enable loreline, /bin/systemctl disable loreline, /bin/systemctl is-enabled loreline, /bin/systemctl is-active loreline, /bin/systemd-run --on-active=2 --unit=loreline-restart --collect systemctl restart loreline
loreline ALL=(root) NOPASSWD: /usr/bin/systemctl start loreline, /usr/bin/systemctl stop loreline, /usr/bin/systemctl enable loreline, /usr/bin/systemctl disable loreline, /usr/bin/systemctl is-enabled loreline, /usr/bin/systemctl is-active loreline, /usr/bin/systemd-run --on-active=2 --unit=loreline-restart --collect systemctl restart loreline
